{
  "name": "phelierium",
  "private": true,
  "version": "3.2.7",
  "description": "Phelierium Game Hub is a modern Windows gaming hub with an integrated Nexus Mods management experience.",
  "author": "Guilherme Sant'Ana",
  "homepage": "https://github.com/Guilhermesttt/Checkpoint---Launcher",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "electron:dev": "node scripts/electron-dev.cjs",
    "electron:dev:2": "node scripts/start-electron-dev.cjs --profile=2",
    "build": "tsc -b && vite build",
    "dist": "node scripts/build-portable.cjs",
    "dist:windows": "node scripts/build-portable.cjs",
    "dist:installer": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-win-installer.ps1",
    "build:exe": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-win-installer.ps1",
    "build:portable": "node scripts/build-portable.cjs",
    "publish": "npm run build && electron-builder --win --publish always",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "test:coverage": "vitest run --coverage",
    "test:coverage:trophies": "vitest run --config tests/coverage-thresholds.vitest.config.ts --coverage",
    "test:ci": "npm run test:typecheck && npm run test",
    "db:push": "npx supabase db push",
    "db:lint": "npx supabase db lint --linked --level warning",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "security:secrets": "node scripts/scan-secrets.cjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:gate": "node scripts/security-gate.cjs",
    "release:verify": "node scripts/verify-release.cjs",
    "release:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-installer.ps1",
    "preview": "vite preview",
    "server": "node ./server/index.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guilhermesttt/Checkpoint---Launcher.git"
  },
  "build": {
    "appId": "com.phelierium.hub",
    "productName": "Phelierium",
    "protocols": [
      {
        "name": "Phelierium Game Hub",
        "schemes": [
          "phelierium",
          "pherielium",
          "checkpoint",
          "nxm"
        ]
      }
    ],
    "artifactName": "Phelierium-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Guilhermesttt",
      "repo": "Checkpoint---Launcher"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "public/**/*",
      "package.json",
      "src/assets/hedrabionics_pindown.io.mp4",
      "src/assets/Overlay_Background.mp4",
      "src/sounds/**/*",
      "src/assets/**/*",
      "node_modules/@fontsource-variable/**/*",
      "node_modules/node-hid/**/*",
      "node_modules/pkg-prebuilds/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "assets/icon.ico",
      "src/assets/hedrabionics_pindown.io.mp4",
      "src/assets/Overlay_Background.mp4",
      "src/sounds/**/*",
      "node_modules/node-hid/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "assets/installerSidebar.bmp",
      "uninstallerSidebar": "assets/installerSidebar.bmp",
      "installerHeader": "assets/installerHeader.bmp",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pherielium"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/stix-two-text": "^5.2.8",
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "@supabase/supabase-js": "^2.112.2",
    "@types/react-window": "^1.8.8",
    "adm-zip": "^0.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "express-rate-limit": "8.7.0",
    "figma-squircle": "^1.1.0",
    "google-auth-library": "^10.9.0",
    "helmet": "8.3.0",
    "html2canvas": "^1.4.1",
    "livekit-client": "^2.22.0",
    "livekit-server-sdk": "^2.18.0",
    "motion": "^13.2.0",
    "node-fetch": "^3.3.2",
    "node-hid": "^3.4.0",
    "node-stream-zip": "^1.16.0",
    "orbloom": "^0.1.0",
    "react-window": "^2.3.0",
    "sharp": "^0.35.3",
    "thinking-orbs": "^0.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0",
    "@eslint/js": "^9.39.4",
    "@fortawesome/fontawesome-svg-core": "7.3.0",
    "@fortawesome/free-brands-svg-icons": "7.3.0",
    "@fortawesome/react-fontawesome": "3.3.1",
    "@hookform/resolvers": "^5.2.2",
    "@liquidglass/react": "0.1.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "9.2.4",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "dompurify": "3.4.14",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-average-color": "^9.5.2",
    "framer-motion": "^12.43.0",
    "geist": "^1.7.0",
    "globals": "^17.4.0",
    "input-otp": "^1.4.2",
    "jsdom": "^29.1.1",
    "liquid-glass-react": "^1.1.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "png-to-ico": "^3.0.1",
    "react": "^19.2.4",
    "react-bits": "^1.0.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.73.1",
    "react-icons": "^5.6.0",
    "react-resizable-panels": "^4.10.0",
    "react-router-dom": "^6.26.1",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "supertest": "^7.2.2",
    "tailwind-merge": "^3.5.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.2.2",
    "terser": "^5.50.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  }
}
